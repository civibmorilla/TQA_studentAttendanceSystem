PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/attendify?retryWrites=true&w=majority
# Use a long random string in production, never commit the real one
JWT_SECRET=change_me_to_a_long_random_string
# Optional: separate secret for signing QR codes (falls back to JWT_SECRET)
QR_SECRET=
# Timezone used to decide "today" for attendance dates
SCHOOL_TIMEZONE=Asia/Manila
# How long a login lasts (default 1d)
JWT_EXPIRES_IN=1d
# Comma-separated list of front-end URLs allowed to call the API (your Vercel URL)
# e.g. CLIENT_URL=http://localhost:5173,https://tqa-student-attendance-system.vercel.app
# Set to true only if you need Vercel *preview* deployments to reach the API
ALLOW_VERCEL_PREVIEWS=false
